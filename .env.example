# biblioteca-prestamos: copia este archivo a .env y rellena cada valor. El .env no se sube a GitHub.

# Emisor de los tokens (el mismo COGNITO_ISSUER del gateway y del BFF). Aqui solo se usa para bajar
# el JWKS en <emisor>/.well-known/jwks.json y verificar firma, iss y exp.
COGNITO_ISSUER=

# Broker donde se publican prestamo.creado y prestamo.devuelto (exchange biblioteca.eventos).
RABBITMQ_URL=

# Postgres: este servicio es dueno del esquema "prestamos" y lo crea al arrancar con esquema.sql.
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Kafka (L9): cluster donde se publican prestamo.creado y prestamo.devuelto en biblioteca.prestamos.
# Con el servicio corriendo en el equipo van estos tres puertos; en el compose, biblioteca-plataforma lo
# reemplaza por broker-1:19092,broker-2:19092,broker-3:19092.
KAFKA_BROKERS=localhost:9092,localhost:9094,localhost:9096
